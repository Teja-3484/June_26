class Solution:
    def maximumSwap(self, num: int) -> int:
        nums = list(str(num))

        for i in range(len(nums)):
            maxi = nums[i]
            idx = i

            for j in range(i + 1, len(nums)):
                if nums[j] >= maxi:
                    maxi = nums[j]
                    idx = j

            if maxi > nums[i]:
                nums[i], nums[idx] = nums[idx], nums[i]
                break

        return int("".join(nums))
