class Solution:
    def tribonacci(self, n: int) -> int:
        if n == 0:
            return 0
        elif n == 1:
            return 1
        elif n == 2:
            return 1

        p, r, s = 0, 1, 1

        for i in range(3, n + 1):
            ans = p + r + s
            p = r
            r = s
            s = ans

        return s
