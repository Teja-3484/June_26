class Solution:
    def countLargestGroup(self, n: int) -> int:
        d = {}

        for i in range(1, n + 1):
            s = sum(int(x) for x in str(i))

            if s in d:
                d[s] += 1
            else:
                d[s] = 1

        m = max(d.values())

        ans = 0

        for i in d:
            if d[i] == m:
                ans += 1

        return ans
