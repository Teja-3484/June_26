class Solution:
    def sortArrayByParityII(self, nums: List[int]) -> List[int]:
        ans = [0] * len(nums)

        e = 0
        o = 1

        for i in range(len(nums)):
            if nums[i] % 2 == 0:
                ans[e] = nums[i]
                e += 2
            else:
                ans[o] = nums[i]
                o += 2

        return ans
