class Solution:
    def countCharacters(self, words: List[str], chars: str) -> int:
        ans = 0

        for i in range(len(words)):
            temp = chars
            flag = True

            for j in words[i]:
                if j in temp:
                    temp = temp.replace(j, "", 1)
                else:
                    flag = False
                    break

            if flag:
                ans += len(words[i])

        return ans
