class Solution:
    def commonChars(self, words: List[str]) -> List[str]:
        ans = []

        for ch in words[0]:
            flag = 1

            for i in range(1, len(words)):
                if ch not in words[i]:
                    flag = 0
                    break

            if flag:
                ans.append(ch)

                for i in range(1, len(words)):
                    words[i] = words[i].replace(ch, "", 1)

        return ans
